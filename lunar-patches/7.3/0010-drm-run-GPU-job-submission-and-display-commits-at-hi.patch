From 1969cd3f0cb0a8330c669fd82e5ec87484e74f3f Mon Sep 17 00:00:00 2001
From: "Claude (draft)" <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 15:48:16 +0100
Subject: [PATCH 10/10] drm: run GPU job submission and display commits at high
 priority

The work that gets a frame onto the screen runs in kworkers at normal
priority:

- drm_sched's run_job and free_job, on the scheduler's ordered submit
  queue (amdgpu, xe's GuC exec queues and others don't pass their own),
  and on nouveau's own submit queues,
- nonblocking atomic commits, the compositor's page flips, on
  system_dfl_wq, whose unbound nice 0 pool is shared with other unbound
  work such as filesystem I/O completion,
- amdgpu_dm's vblank control worker, which holds dc_lock, a lock the
  commit path takes as well,
- amdgpu_dm's vmin/vmax worker, queued from the vblank interrupt on every
  frame while VRR is possible; it takes dc_lock too and has to program
  the VRR timing before the next VUPDATE.

With all cpus busy these workers wait for a cpu like any other task.
Measured with a workqueue_queue_work -> workqueue_execute_start tracer
during a game under sched_ext (a game at nice -5, the compositor at
nice -12) with stress-ng --cpu 0 in the background, about 120 s:

  work                        items     >= 1 ms   >= 4 ms   max
  drm_sched_run_job_work      844525    748       63        8-16 ms
  commit_work                 19747     314       47        8-16 ms
  vblank_control_worker       13731     482       101       8-16 ms

The same game without background load had no run_job delay over 1 ms
and two commit delays of 1-2 ms. Delays of several ms for a page flip
on a 165 Hz display (6 ms per frame) are missed vblanks.

Allocate the scheduler's queue, nouveau's two submit queues (the shared
one and the per-client one VM_BIND/NVK uses) and amdgpu_dm's vblank
control and vmin/vmax queues with WQ_HIGHPRI, and run nonblocking commits on a new
unbound WQ_HIGHPRI queue of drm_kms_helper, drm_atomic_commit_wq. It is
unbound and not ordered like system_dfl_wq, so consecutive commits
still overlap, and commits fall back to system_dfl_wq if it could not
be allocated.
High priority workers run at nice -20; this work is short and runs a
few times per frame.

DRAFT for linux-lunar; not submitted upstream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HhEc6jiSB1p6Eb6tsXUo21
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  8 ++++-
 .../drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c |  7 ++++-
 drivers/gpu/drm/drm_atomic_helper.c           |  8 +++--
 drivers/gpu/drm/drm_crtc_helper_internal.h    |  4 +++
 drivers/gpu/drm/drm_kms_helper_common.c       | 29 +++++++++++++++++++
 drivers/gpu/drm/nouveau/nouveau_drm.c         |  4 +--
 drivers/gpu/drm/nouveau/nouveau_sched.c       |  5 ++--
 drivers/gpu/drm/scheduler/sched_main.c        |  9 ++++--
 8 files changed, 63 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index f3551bd0b..f79423b56 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -725,8 +725,14 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 	amdgpu_dm_init_color_mod();
 
 	if (adev->dm.dc->caps.max_links > 0) {
+		/*
+		 * The worker takes dc_lock, which the commit path needs as
+		 * well: at normal priority it can wait for a cpu, or be
+		 * preempted holding the lock, and hold up a page flip.
+		 */
 		adev->dm.vblank_control_workqueue =
-			create_singlethread_workqueue("dm_vblank_control_workqueue");
+			alloc_ordered_workqueue("dm_vblank_control_workqueue",
+						WQ_MEM_RECLAIM | WQ_HIGHPRI);
 		if (!adev->dm.vblank_control_workqueue)
 			drm_err(adev_to_drm(adev), "failed to initialize vblank_workqueue.\n");
 	}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
index 74a873516..6e6d6397d 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
@@ -404,8 +404,13 @@ int amdgpu_dm_irq_init(struct amdgpu_device *adev)
 	if (!adev->dm.irq_wq)
 		return -ENOMEM;
 
+	/*
+	 * Queued from the vblank interrupt on every frame while VRR is
+	 * possible; the worker takes dc_lock, which page flips need too,
+	 * and has to program vmin/vmax before the next VUPDATE.
+	 */
 	adev->dm.vmin_vmax_wq = alloc_workqueue("amdgpu_dm_vmin_vmax",
-		WQ_UNBOUND, 0);
+		WQ_UNBOUND | WQ_HIGHPRI, 0);
 
 	if (!adev->dm.vmin_vmax_wq) {
 		destroy_workqueue(adev->dm.irq_wq);
diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 285aac355..a36362bc5 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -2307,13 +2307,15 @@ int drm_atomic_helper_commit(struct drm_device *dev,
 	 * current layout.
 	 *
 	 * NOTE: Commit work has multiple phases, first hardware commit, then
-	 * cleanup. We want them to overlap, hence need system_dfl_wq to
-	 * make sure work items don't artificially stall on each another.
+	 * cleanup. We want them to overlap, hence need an unbound queue
+	 * (drm_atomic_commit_wq, or system_dfl_wq without it) to make sure
+	 * work items don't artificially stall on each another.
 	 */
 
 	drm_atomic_commit_get(state);
 	if (nonblock)
-		queue_work(system_dfl_wq, &state->commit_work);
+		queue_work(drm_atomic_commit_wq ?: system_dfl_wq,
+			   &state->commit_work);
 	else
 		commit_tail(state);
 
diff --git a/drivers/gpu/drm/drm_crtc_helper_internal.h b/drivers/gpu/drm/drm_crtc_helper_internal.h
index bae73936a..08cd2d6c5 100644
--- a/drivers/gpu/drm/drm_crtc_helper_internal.h
+++ b/drivers/gpu/drm/drm_crtc_helper_internal.h
@@ -35,6 +35,10 @@ struct drm_crtc;
 struct drm_display_mode;
 struct drm_encoder;
 struct drm_modeset_acquire_ctx;
+struct workqueue_struct;
+
+/* drm_kms_helper_common.c */
+extern struct workqueue_struct *drm_atomic_commit_wq;
 
 /* drm_probe_helper.c */
 enum drm_mode_status drm_crtc_mode_valid(struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/drm_kms_helper_common.c b/drivers/gpu/drm/drm_kms_helper_common.c
index 0c7550c04..4df0255a8 100644
--- a/drivers/gpu/drm/drm_kms_helper_common.c
+++ b/drivers/gpu/drm/drm_kms_helper_common.c
@@ -26,6 +26,35 @@
  */
 
 #include <linux/module.h>
+#include <linux/workqueue.h>
+
+#include "drm_crtc_helper_internal.h"
+
+/*
+ * Nonblocking atomic commits (the compositor's page flips) run here. Like
+ * system_dfl_wq it is unbound and not ordered, so the phases of consecutive
+ * commits still overlap, but its workers run at nice -20 and don't share a
+ * pool with other unbound work (filesystem I/O completion and the like). With
+ * all cpus busy, a commit on system_dfl_wq could wait milliseconds for a
+ * worker and miss its vblank. NULL if it could not be allocated: commits then
+ * use system_dfl_wq as before.
+ */
+struct workqueue_struct *drm_atomic_commit_wq;
+
+static int __init drm_kms_helper_init(void)
+{
+	drm_atomic_commit_wq = alloc_workqueue("drm_atomic_commit",
+					       WQ_UNBOUND | WQ_HIGHPRI, 0);
+	return 0;
+}
+module_init(drm_kms_helper_init);
+
+static void __exit drm_kms_helper_exit(void)
+{
+	if (drm_atomic_commit_wq)
+		destroy_workqueue(drm_atomic_commit_wq);
+}
+module_exit(drm_kms_helper_exit);
 
 MODULE_AUTHOR("David Airlie, Jesse Barnes");
 MODULE_DESCRIPTION("DRM KMS helper");
diff --git a/drivers/gpu/drm/nouveau/nouveau_drm.c b/drivers/gpu/drm/nouveau/nouveau_drm.c
index 2c7077a49..c869571b6 100644
--- a/drivers/gpu/drm/nouveau/nouveau_drm.c
+++ b/drivers/gpu/drm/nouveau/nouveau_drm.c
@@ -633,8 +633,8 @@ nouveau_drm_device_init(struct nouveau_drm *drm)
 	struct drm_device *dev = drm->dev;
 	int ret;
 
-	drm->sched_wq = alloc_workqueue("nouveau_sched_wq_shared", WQ_PERCPU,
-					WQ_MAX_ACTIVE);
+	drm->sched_wq = alloc_workqueue("nouveau_sched_wq_shared",
+					WQ_PERCPU | WQ_HIGHPRI, WQ_MAX_ACTIVE);
 	if (!drm->sched_wq)
 		return -ENOMEM;
 
diff --git a/drivers/gpu/drm/nouveau/nouveau_sched.c b/drivers/gpu/drm/nouveau/nouveau_sched.c
index b3f02c490..f87a90ffc 100644
--- a/drivers/gpu/drm/nouveau/nouveau_sched.c
+++ b/drivers/gpu/drm/nouveau/nouveau_sched.c
@@ -414,8 +414,9 @@ nouveau_sched_init(struct nouveau_sched *sched, struct nouveau_drm *drm,
 	int ret;
 
 	if (!wq) {
-		wq = alloc_workqueue("nouveau_sched_wq_%d", WQ_PERCPU,
-				     WQ_MAX_ACTIVE,
+		/* run_job/free_job of every frame, see drm_sched_alloc_wq() */
+		wq = alloc_workqueue("nouveau_sched_wq_%d",
+				     WQ_PERCPU | WQ_HIGHPRI, WQ_MAX_ACTIVE,
 				     current->pid);
 		if (!wq)
 			return -ENOMEM;
diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 6cb6f9546..09e90676d 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -1071,6 +1071,11 @@ static void drm_sched_run_job_work(struct work_struct *w)
 	drm_sched_run_job_queue(sched);
 }
 
+/*
+ * run_job and free_job of every frame go through this queue. With normal
+ * priority workers they wait for a cpu like any other task when all cpus are
+ * busy, and the frame reaches the GPU late; WQ_HIGHPRI workers run at nice -20.
+ */
 static struct workqueue_struct *drm_sched_alloc_wq(const char *name)
 {
 #if (IS_ENABLED(CONFIG_LOCKDEP))
@@ -1084,9 +1089,9 @@ static struct workqueue_struct *drm_sched_alloc_wq(const char *name)
 	 * allocated submit_wq.
 	 */
 
-	return alloc_ordered_workqueue_lockdep_map(name, WQ_MEM_RECLAIM, &map);
+	return alloc_ordered_workqueue_lockdep_map(name, WQ_MEM_RECLAIM | WQ_HIGHPRI, &map);
 #else
-	return alloc_ordered_workqueue(name, WQ_MEM_RECLAIM);
+	return alloc_ordered_workqueue(name, WQ_MEM_RECLAIM | WQ_HIGHPRI);
 #endif
 }
 
