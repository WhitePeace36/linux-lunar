From ec48a911003bc72f0ec057108f75d7863da4c12f Mon Sep 17 00:00:00 2001
From: "Claude (draft)" <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 16:53:48 +0100
Subject: [PATCH 3/7] drm/ttm: add low_latency_alloc parameter to bound
 beneficial-order retries

ttm_pool_alloc_page() allocates the driver's beneficial order (2 MiB
for amdgpu) with __GFP_RETRY_MAYFAIL, which keeps retrying direct
reclaim and compaction with escalating priority. On a fragmented
system this can stall the thread that creates or populates a BO, e.g.
a game's render or asset-streaming thread on an APU or with GTT
placements.

Add ttm.low_latency_alloc to choose the reclaim effort for the
beneficial order:

  0  retry hard with __GFP_RETRY_MAYFAIL (default, unchanged)
  1  keep the __GFP_NORETRY used for other high orders: one bounded
     round of direct reclaim/compaction
  2  no direct reclaim/compaction at all; only wake kswapd/kcompactd

A failed attempt falls back to smaller orders in every mode. Y and N
are accepted as 1 and 0.

DRAFT for linux-lunar; not submitted upstream. Test status: see
the linux-lunar README.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Jpc2uj1P9if4WYVKq5YGZK
---
 drivers/gpu/drm/ttm/ttm_pool.c | 64 ++++++++++++++++++++++++++++++++--
 1 file changed, 62 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_pool.c b/drivers/gpu/drm/ttm/ttm_pool.c
index 1bf37023f..a4d31f917 100644
--- a/drivers/gpu/drm/ttm/ttm_pool.c
+++ b/drivers/gpu/drm/ttm/ttm_pool.c
@@ -134,6 +134,46 @@ static unsigned long page_pool_size;
 MODULE_PARM_DESC(page_pool_size, "Number of pages in the WC/UC/DMA pool per NUMA node");
 module_param(page_pool_size, ulong, 0644);
 
+/*
+ * Reclaim effort for the driver's beneficial page order:
+ *  0 - retry direct reclaim/compaction hard (__GFP_RETRY_MAYFAIL), default
+ *  1 - one bounded round of direct reclaim/compaction (__GFP_NORETRY)
+ *  2 - no direct reclaim/compaction; only wake kswapd/kcompactd
+ * In every mode a failed attempt falls back to smaller orders.
+ */
+static unsigned int ttm_pool_low_latency;
+
+static int ttm_pool_low_latency_set(const char *val,
+				    const struct kernel_param *kp)
+{
+	unsigned int level;
+	bool on;
+
+	if (!val)
+		return -EINVAL;
+	if (!kstrtouint(val, 0, &level)) {
+		if (level > 2)
+			return -EINVAL;
+	} else if (!kstrtobool(val, &on)) {
+		/* Y/N from when this was a bool parameter. */
+		level = on;
+	} else {
+		return -EINVAL;
+	}
+	WRITE_ONCE(*(unsigned int *)kp->arg, level);
+	return 0;
+}
+
+static const struct kernel_param_ops ttm_pool_low_latency_ops = {
+	.set = ttm_pool_low_latency_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(low_latency_alloc, &ttm_pool_low_latency_ops,
+		&ttm_pool_low_latency, 0644);
+MODULE_PARM_DESC(low_latency_alloc,
+		 "Reclaim effort for the driver's beneficial page order: 0 = retry hard (default), 1 = one bounded round, 2 = none, only wake kswapd");
+
 static unsigned long pool_node_limit[MAX_NUMNODES];
 static atomic_long_t allocated_pages[MAX_NUMNODES];
 
@@ -183,9 +223,29 @@ static struct page *ttm_pool_alloc_page(struct ttm_pool *pool, gfp_t gfp_flags,
 	if (order && beneficial_order && order != beneficial_order)
 		gfp_flags &= ~__GFP_RECLAIM;
 
+	/*
+	 * By default the beneficial order retries reclaim and compaction
+	 * hard (__GFP_RETRY_MAYFAIL). On a fragmented system that can stall
+	 * the submitting thread (often a game's render or streaming thread)
+	 * for a long time. ttm.low_latency_alloc=1 keeps __GFP_NORETRY from
+	 * above: one bounded round of direct reclaim/compaction. With 2 the
+	 * thread never reclaims or compacts for this order; kswapd and
+	 * kcompactd are woken to produce blocks in the background
+	 * (__GFP_NOMEMALLOC above keeps it out of the atomic reserves).
+	 * Either way a failure falls back to smaller orders.
+	 */
 	if (beneficial_order && order == beneficial_order) {
-		gfp_flags &= ~__GFP_NORETRY;
-		gfp_flags |= __GFP_RETRY_MAYFAIL;
+		switch (READ_ONCE(ttm_pool_low_latency)) {
+		case 0:
+			gfp_flags &= ~__GFP_NORETRY;
+			gfp_flags |= __GFP_RETRY_MAYFAIL;
+			break;
+		case 1:
+			break;
+		default:
+			gfp_flags &= ~__GFP_DIRECT_RECLAIM;
+			break;
+		}
 	}
 
 	if (!ttm_pool_uses_dma_alloc(pool)) {
-- 
