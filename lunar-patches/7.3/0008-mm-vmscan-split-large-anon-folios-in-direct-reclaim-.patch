diff --git a/mm/swapfile.c b/mm/swapfile.c
index 601979b97..443ed9ff7 100644
--- a/mm/swapfile.c
+++ b/mm/swapfile.c
@@ -1430,6 +1430,42 @@ static void swap_alloc_slow(struct folio *folio)
 	spin_unlock(&swap_avail_lock);
 }
 
+/**
+ * swap_out_is_synchronous - does swapping out cost the caller CPU per page?
+ * @order: order of the folio about to be swapped out
+ *
+ * Return: true if zswap is enabled, or if the swap device that a folio of
+ * @order would most likely be written to from this CPU does synchronous
+ * I/O (zram, ...). Swapping out then compresses or copies every page of
+ * the folio in the calling task. A racy hint for reclaim.
+ */
+bool swap_out_is_synchronous(unsigned int order)
+{
+	struct swap_info_struct *si;
+	bool ret = false;
+
+	if (zswap_is_enabled())
+		return true;
+
+	if (order >= SWAP_NR_ORDERS)
+		order = 0;
+
+	/* swap_info_structs are never freed, see swap_alloc_fast() */
+	si = this_cpu_read(percpu_swap_cluster.si[order]);
+	if (si)
+		return data_race(si->flags & SWP_SYNCHRONOUS_IO);
+
+	spin_lock(&swap_avail_lock);
+	if (!plist_head_empty(&swap_avail_head)) {
+		si = plist_first_entry(&swap_avail_head, struct swap_info_struct,
+				       avail_list);
+		ret = si->flags & SWP_SYNCHRONOUS_IO;
+	}
+	spin_unlock(&swap_avail_lock);
+
+	return ret;
+}
+
 /*
  * Discard pending clusters in a synchronized way when under high pressure.
  * Return: true if any cluster is discarded.
diff --git a/mm/vmscan.c b/mm/vmscan.c
index 6bfa839b8..49791ac41 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -1085,6 +1085,72 @@ static bool may_enter_fs(struct folio *folio, gfp_t gfp_mask)
 	return false;
 }
 
+/* vm.thp_direct_reclaim_split, see direct_reclaim_keep_large_anon() */
+static int sysctl_thp_direct_reclaim_split __read_mostly;
+
+/*
+ * Swapping out a large anon folio to zram (or any synchronous swap device,
+ * or zswap) compresses every page of it in the reclaiming task: 3-4 ms for
+ * a 2 MiB THP with zstd. In direct reclaim, whichever task allocates while
+ * memory is short pays for that (an audio thread, the compositor, a game),
+ * typically for an order-0 request that needs SWAP_CLUSTER_MAX pages.
+ *
+ * So in direct reclaim, split the folio instead, keep reclaiming about as
+ * many pages as the caller still needs from its start (an aligned,
+ * physically contiguous range, which also suits small higher-order
+ * requests) plus any pages the split left unmapped, and return the other
+ * pages to the LRU for kswapd. kswapd, proactive reclaim and MADV_PAGEOUT
+ * (ignore_references) still swap out large folios whole. If the split
+ * fails, the folio is swapped out whole as before. If the caller already
+ * reclaimed enough, keep the folio.
+ *
+ * Return: true if the caller should keep @folio, false to reclaim it (now
+ * possibly order 0, with the other pages to reclaim queued on @folio_list).
+ */
+static bool direct_reclaim_keep_large_anon(struct folio *folio,
+		struct scan_control *sc, unsigned int nr_reclaimed,
+		struct list_head *folio_list, struct list_head *ret_folios)
+{
+	unsigned long target, done, want;
+	struct folio *tail, *next;
+	LIST_HEAD(split);
+
+	if (!READ_ONCE(sysctl_thp_direct_reclaim_split) ||
+	    current_is_kswapd() || sc->proactive ||
+	    !swap_out_is_synchronous(folio_order(folio)))
+		return false;
+
+	target = max(sc->nr_to_reclaim, compact_gap(sc->order));
+	done = sc->nr_reclaimed + nr_reclaimed;
+	if (done >= target)
+		return true;
+
+	want = max(target - done, (unsigned long)SWAP_CLUSTER_MAX);
+	if (want >= folio_nr_pages(folio) / 2)
+		return false;
+
+	if (split_folio_to_list(folio, &split))
+		return false;
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	count_vm_event(THP_SWPOUT_DIRECT_SPLIT);
+#endif
+
+	/* @folio is the first page now; tails come in address order */
+	want--;
+	list_for_each_entry_safe(tail, next, &split, lru) {
+		if (!folio_mapped(tail)) {
+			list_move_tail(&tail->lru, folio_list);
+		} else if (want) {
+			want--;
+			list_move_tail(&tail->lru, folio_list);
+		} else {
+			list_move(&tail->lru, ret_folios);
+		}
+	}
+
+	return false;
+}
+
 /*
  * shrink_folio_list() returns the number of reclaimed pages
  */
@@ -1309,6 +1375,10 @@ static unsigned int shrink_folio_list(struct list_head *folio_list,
 				    folio_test_partially_mapped(folio)) &&
 				    split_folio_to_list(folio, folio_list))
 					goto activate_locked;
+				if (folio_test_large(folio) && !ignore_references &&
+				    direct_reclaim_keep_large_anon(folio, sc,
+						nr_reclaimed, folio_list, &ret_folios))
+					goto keep_locked;
 			}
 			if (folio_alloc_swap(folio)) {
 				int __maybe_unused order = folio_order(folio);
@@ -7765,6 +7835,15 @@ static const struct ctl_table vmscan_sysctl_table[] = {
 		.extra1		= SYSCTL_ZERO,
 		.extra2		= SYSCTL_TWO_HUNDRED,
 	},
+	{
+		.procname	= "thp_direct_reclaim_split",
+		.data		= &sysctl_thp_direct_reclaim_split,
+		.maxlen		= sizeof(sysctl_thp_direct_reclaim_split),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE,
+	},
 #ifdef CONFIG_NUMA
 	{
 		.procname	= "zone_reclaim_mode",
