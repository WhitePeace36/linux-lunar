+		.data		= &sysctl_lru_drain_timeout_ms,
+		.maxlen		= sizeof(sysctl_lru_drain_timeout_ms),
+		.mode		= 0644,
+		.proc_handler	= proc_douintvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE_THOUSAND,
+	},
+};
+
+static int __init lru_drain_sysctl_init(void)
+{
+	register_sysctl_init("vm", lru_drain_sysctl_table);
+	return 0;
+}
+subsys_initcall(lru_drain_sysctl_init);
