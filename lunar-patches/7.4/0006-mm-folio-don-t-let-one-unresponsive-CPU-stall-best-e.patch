+static unsigned int sysctl_lru_drain_timeout_ms __read_mostly = 20;
+
+/* After this long, a strict drain reports which CPUs it is waiting for. */
+#define LRU_DRAIN_WARN_MS	1000
+
+/*
+ * Wake drain waiters, if there are any. Every per-CPU drain work calls
+ * this, so skip the wait queue lock when nobody waits. wq_has_sleeper()
+ * contains the full barrier that orders the caller's preceding store
+ * (done_gen, or the mutex release) before the check; it pairs with the
+ * barrier in prepare_to_wait() in wait_event_timeout().
+ */
+static void lru_drain_wake(void)
 {
+	if (wq_has_sleeper(&lru_drain_wq))
+		wake_up_all(&lru_drain_wq);
+}
+
+static void lru_add_drain_per_cpu(struct work_struct *work)
+{
+	struct lru_drain_work *dw = container_of(work, struct lru_drain_work,
+						 work);
+	/*
+	 * Sample the generation before draining: if a waiter sees
+	 * done_gen >= its own generation, this drain started after that
+	 * generation was published and so after the waiter's own folio
+	 * batch updates (see (D) below). Pending work items only start
+	 * after the queueing CPU's (D), see process_one_work().
+	 */
+	unsigned int gen = READ_ONCE(lru_drain_gen);
+
 	lru_add_and_bh_lrus_drain();
+
+	/* Pairs with smp_load_acquire() in lru_drain_cpus_done(). */
+	smp_store_release(&dw->done_gen, gen);
+	lru_drain_wake();
 }
 
