+/*
+ * lru_drain_gen - Global pages generation number
+ *
+ * (A) Definition: global lru_drain_gen = x implies that all generations
+ *     0 < n <= x are already *scheduled* for draining.
+ *
+ * lru_drain_completed - newest generation whose drain has finished on
+ * every CPU that needed it. Only written with lru_drain_lock held.
+ *
+ * These two used to be the same thing, because the mutex was held until
+ * every CPU had drained. lru_add_drain_all_bounded() can now drop the
+ * mutex while some per-CPU works are still pending, so "scheduled" no
+ * longer implies "done".
+ */
+static unsigned int lru_drain_gen;
+static unsigned int lru_drain_completed;
+static DEFINE_MUTEX(lru_drain_lock);
+static DECLARE_WAIT_QUEUE_HEAD(lru_drain_wq);
 
-static void lru_add_drain_per_cpu(struct work_struct *dummy)
+/*
