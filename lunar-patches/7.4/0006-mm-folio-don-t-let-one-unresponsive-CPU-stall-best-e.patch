+/**
+ * lru_add_drain_all_bounded() - drain LRU caches on all CPUs, but don't
+ *				 wait for unresponsive CPUs for long
+ *
+ * Like lru_add_drain_all(), but gives up after vm.lru_drain_timeout_ms
+ * instead of waiting for every CPU to run its drain work. Meant for
+ * callers to whom draining is an optimisation (khugepaged, fadvise,
+ * KSM, proactive reclaim, ...): one CPU that cannot run its kworker
+ * should not stall them, or everyone queued behind them on the drain
+ * mutex.
+ *
+ * Return: true if every CPU's caches were drained, false if it gave up.
+ */
+bool lru_add_drain_all_bounded(void)
+{
+	unsigned int ms = READ_ONCE(sysctl_lru_drain_timeout_ms);
+
+	return __lru_add_drain_all(false, ms ? max(msecs_to_jiffies(ms), 1UL) : 0);
 }
