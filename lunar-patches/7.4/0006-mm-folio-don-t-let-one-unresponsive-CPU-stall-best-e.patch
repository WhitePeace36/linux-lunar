+static bool lru_drain_cpus_done(const struct cpumask *mask, unsigned int gen)
+{
+	unsigned int cpu;
+
+	for_each_cpu(cpu, mask) {
+		unsigned int done =
+			smp_load_acquire(&per_cpu(lru_drain_works, cpu).done_gen);
+
+		if ((int)(done - gen) < 0)
+			return false;
+	}
+	return true;
+}
+
+/* Clear @mask bits of CPUs that have already drained for @gen. */
+static void lru_drain_cpus_pending(struct cpumask *mask, unsigned int gen)
+{
+	unsigned int cpu;
+
+	for_each_cpu(cpu, mask) {
+		unsigned int done =
+			smp_load_acquire(&per_cpu(lru_drain_works, cpu).done_gen);
+
+		if ((int)(done - gen) >= 0)
+			__cpumask_clear_cpu(cpu, mask);
+	}
+}
+
+/*
+ * Take lru_drain_lock, giving up at @deadline. Holders wake lru_drain_wq
+ * on release, so this sleeps instead of spinning.
+ */
+static bool lru_drain_lock_until(unsigned long deadline)
+{
+	while (!mutex_trylock(&lru_drain_lock)) {
+		long left = (long)(deadline - jiffies);
+
+		if (left <= 0)
+			return false;
+		wait_event_timeout(lru_drain_wq,
+				   !mutex_is_locked(&lru_drain_lock), left);
+	}
+	return true;
+}
+
+static void lru_drain_unlock(void)
+{
+	mutex_unlock(&lru_drain_lock);
+	lru_drain_wake();
+}
