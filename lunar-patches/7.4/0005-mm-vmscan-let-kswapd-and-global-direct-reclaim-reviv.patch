From 4b4c70acc48829bf545a6166c054628fee57fc2b Mon Sep 17 00:00:00 2001
From: "Claude (draft)" <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 22:40:29 +0100
Subject: [PATCH 5/7] mm/vmscan: let kswapd and global direct reclaim revive a
 hopeless kswapd

kswapd marks a node hopeless after MAX_RECLAIM_RETRIES runs that
reclaimed nothing and is then no longer woken. kswapd_try_clear_hopeless()
only clears that state once the node is balanced, i.e. free memory is
above the high watermark. That was done so that cgroup reclaim
(memory.high throttling) cannot keep resetting the counter for a node
kswapd cannot balance.

On a single-node machine this can leave kswapd off for as long as the
system stays under pressure. Global direct reclaim frees just enough
for its own allocation (SWAP_CLUSTER_MAX at a time) and rarely lifts
free memory to the high watermark, least of all with a raised
vm.watermark_scale_factor. The PCP freeing path only clears the state
when another memory node exists. kswapd's own successful runs no longer
reset the counter either, so zero-progress runs accumulate over time
instead of having to be consecutive.

Observed on 7.3.1 (tkg build, 32 GiB, zram, watermark_scale_factor=500)
under a synthetic load with 16 GiB of anonymous memory and streaming
file reads: node_unreclaimable stayed 1 before and throughout a
120 s run; pgscan_kswapd 0, pgscan_direct 53M, allocstall 820k.

Keep the balanced requirement for cgroup reclaim, but let progress made
by kswapd itself or by global direct reclaim clear the hopeless state,
as before. kswapd then again only gives up after consecutive failures.
The counter is read before it is reset, so the frequent calls from
direct reclaim don't keep writing to a cache line that every
allocation slow path reads.

DRAFT for linux-lunar; not submitted upstream. Test status: see
the linux-lunar README.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Jpc2uj1P9if4WYVKq5YGZK
---
 mm/vmscan.c | 37 +++++++++++++++++++++++++++++++++++--
 1 file changed, 35 insertions(+), 2 deletions(-)

diff --git a/mm/vmscan.c b/mm/vmscan.c
index 225b67aa6..1bcbe5016 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -284,6 +284,39 @@ static bool writeback_throttling_sane(struct scan_control *sc)
 }
 #endif
 
+/*
+ * Reclaim made progress on @pgdat. If that progress came from kswapd itself
+ * or from global direct reclaim, the node is evidently reclaimable: revive a
+ * kswapd that gave up on it. Only cgroup reclaim (memory.high/max, proactive
+ * memory.reclaim) still has to wait until the node is balanced, so that
+ * reclaim confined to one cgroup cannot keep a kswapd running endlessly
+ * against a node it cannot balance (see kswapd_try_clear_hopeless()).
+ *
+ * Requiring the node to be balanced for every reclaimer leaves a single-node
+ * machine without kswapd for as long as it stays under pressure: direct
+ * reclaim frees just enough for its own allocation and rarely lifts free
+ * memory to the high watermark, least of all with a large
+ * watermark_scale_factor. Every allocation then reclaims for itself.
+ */
+static void reclaim_progress_clear_hopeless(pg_data_t *pgdat,
+					    struct scan_control *sc)
+{
+	if (cgroup_reclaim(sc)) {
+		kswapd_try_clear_hopeless(pgdat, sc->order, sc->reclaim_idx);
+		return;
+	}
+	/*
+	 * This runs after every reclaim pass that made progress, on every
+	 * CPU in direct reclaim. Read first: an unconditional atomic_xchg()
+	 * would keep bouncing a cache line that wakeup_kswapd() reads in
+	 * every allocation slow path, just when reclaim is busiest.
+	 */
+	if (atomic_read(&pgdat->kswapd_failures))
+		kswapd_clear_hopeless(pgdat, current_is_kswapd() ?
+				      KSWAPD_CLEAR_HOPELESS_KSWAPD :
+				      KSWAPD_CLEAR_HOPELESS_DIRECT);
+}
+
 static inline bool is_exec_file_folio(const struct folio *folio,
 		const vma_flags_t *vma_flags)
 {
@@ -5466,7 +5499,7 @@ static void lru_gen_shrink_node(struct pglist_data *pgdat, struct scan_control *
 	blk_finish_plug(&plug);
 done:
 	if (sc->nr_reclaimed > reclaimed)
-		kswapd_try_clear_hopeless(pgdat, sc->order, sc->reclaim_idx);
+		reclaim_progress_clear_hopeless(pgdat, sc);
 }
 
 /******************************************************************************
@@ -6562,7 +6595,7 @@ static void shrink_node(pg_data_t *pgdat, struct scan_control *sc)
 	 * successful direct reclaim run will revive a dormant kswapd.
 	 */
 	if (reclaimable)
-		kswapd_try_clear_hopeless(pgdat, sc->order, sc->reclaim_idx);
+		reclaim_progress_clear_hopeless(pgdat, sc);
 	else if (sc->cache_trim_mode)
 		sc->cache_trim_mode_failed = 1;
 }
