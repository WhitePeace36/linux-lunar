diff --git a/Documentation/admin-guide/syscall-user-dispatch.rst b/Documentation/admin-guide/syscall-user-dispatch.rst
index c1768d9e8..5a051a4a6 100644
--- a/Documentation/admin-guide/syscall-user-dispatch.rst
+++ b/Documentation/admin-guide/syscall-user-dispatch.rst
@@ -82,6 +82,64 @@ Additionally, a tasks syscall user dispatch configuration can be peeked
 and poked via the PTRACE_(GET|SET)_SYSCALL_USER_DISPATCH_CONFIG ptrace
 requests. This is useful for checkpoint/restart software.
 
+Direct upcall (x86-64)
+----------------------
+
+Delivering every blocked syscall as SIGSYS costs a full signal round
+trip, including saving and restoring the complete extended FPU state.
+Applications that trap at high rates can instead have blocked syscalls
+resume directly at a user-mode handler::
+
+  prctl(PR_SET_SYSCALL_USER_DISPATCH_HANDLER, <handler>, 0, 0, 0)
+  prctl(PR_SET_SYSCALL_USER_DISPATCH, PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON,
+        <offset>, <length>, [selector])
+
+PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON and PR_SYS_DISPATCH_UPCALL_INCLUSIVE_ON
+select the dispatch range like their non-upcall counterparts.  A blocked
+native 64-bit syscall then continues at <handler> with the register state
+the SYSCALL instruction itself produces: RCX holds the address of the
+instruction following the syscall, R11 holds RFLAGS and RAX holds the
+syscall number.  All other registers, the stack, the FPU state and the
+signal mask are left untouched, and no signal is queued.  The handler
+typically emulates the syscall and continues at RCX.
+
+ia32 syscalls (including int $0x80 from 64-bit code) and syscalls issued
+with the trap flag set are still reported with SIGSYS, so a SIGSYS handler
+remains necessary.
+
+The handler is per-task state.  Arming an upcall mode without a handler
+fails with EINVAL, clearing the handler (passing 0) while an upcall mode
+is armed fails with EBUSY, and the handler is reset together with the
+rest of the configuration on clone and exec, so every new thread has to
+register it again.  PTRACE_GET_SYSCALL_USER_DISPATCH_CONFIG reports
+PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON for tasks in upcall mode; the handler
+itself is not part of the ptrace configuration, so a restored task must
+register it before the configuration can be applied.
+
+The handler runs with the RFLAGS of the syscall site, so it cannot rely on
+DF being clear.  Like any indirect branch target it should start with
+ENDBR64.  It is entered without a shadow stack entry, so it returns to the
+syscall site with a jump, not RET.
+
+Entering the handler like a CALL
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Because RCX holds the return address, the kernel has to leave through IRET
+instead of the faster SYSRET (which loads RIP from RCX).  Registering the
+handler with a flag changes that::
+
+  prctl(PR_SET_SYSCALL_USER_DISPATCH_HANDLER, <handler>,
+        PR_SYS_DISPATCH_HANDLER_PUSH_RET, 0, 0)
+
+A blocked syscall then continues at <handler> with the address of the
+instruction following the syscall pushed onto the user stack, below the
+128-byte red zone: [RSP] holds the return address and the stack pointer of
+the syscall site is RSP + 8 + 128.  RCX holds the handler address, R11 holds
+RFLAGS and RAX holds the syscall number; all other registers are left
+untouched.  If the stack cannot be written, the syscall is reported with
+SIGSYS instead.  Kernels without the flag reject it with EINVAL, so
+userspace can try it first and fall back to registering without it.
+
 Security Notes
 --------------
 
@@ -96,4 +154,4 @@ address and modify the selector value.  If the use case requires any
 kind of security sandboxing, Seccomp should be used instead.
 
 Any fork or exec of the existing process resets the mechanism to
-PR_SYS_DISPATCH_OFF.
+PR_SYS_DISPATCH_OFF and clears the upcall handler.
diff --git a/include/linux/syscall_user_dispatch.h b/include/linux/syscall_user_dispatch.h
index 3dd30f4b2..8b5d1f20f 100644
--- a/include/linux/syscall_user_dispatch.h
+++ b/include/linux/syscall_user_dispatch.h
@@ -27,8 +27,23 @@ static __always_inline bool syscall_user_dispatch_clear_on_dispatch(void)
 int set_syscall_user_dispatch(unsigned long mode, unsigned long offset,
 			      unsigned long len, char __user *selector);
 
-#define clear_syscall_work_syscall_user_dispatch(tsk) \
-	clear_task_syscall_work(tsk, SYSCALL_USER_DISPATCH)
+int set_syscall_user_dispatch_handler(unsigned long handler, unsigned long flags);
+
+/*
+ * Reset per-task Syscall User Dispatch state on clone (copy_process) and
+ * exec.  The upcall handler is per-task state and is never inherited: a
+ * stale handler address must not carry into a different binary (think
+ * setuid exec), and each new thread registers its own handler before
+ * arming upcall mode.
+ */
+static inline void clear_syscall_work_syscall_user_dispatch(struct task_struct *tsk)
+{
+	clear_task_syscall_work(tsk, SYSCALL_USER_DISPATCH);
+	tsk->syscall_dispatch.handler = 0;
+	tsk->syscall_dispatch.handler_flags = 0;
+	tsk->syscall_dispatch.on_dispatch = false;
+	tsk->syscall_dispatch.on_upcall = false;
+}
 
 int syscall_user_dispatch_get_config(struct task_struct *task, unsigned long size,
 				     void __user *data);
@@ -54,6 +69,12 @@ static inline int set_syscall_user_dispatch(unsigned long mode, unsigned long of
 	return -EINVAL;
 }
 
+static inline int set_syscall_user_dispatch_handler(unsigned long handler,
+						    unsigned long flags)
+{
+	return -EINVAL;
+}
+
 static inline void clear_syscall_work_syscall_user_dispatch(struct task_struct *tsk)
 {
 }
