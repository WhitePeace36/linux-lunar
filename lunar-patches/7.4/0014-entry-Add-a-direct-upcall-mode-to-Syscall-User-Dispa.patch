+		if (arg4 || arg5)
+			return -EINVAL;
+		error = set_syscall_user_dispatch_handler(arg2, arg3);
+		break;
 #ifdef CONFIG_SCHED_CORE
 	case PR_SCHED_CORE:
 		error = sched_core_share_pid(arg2, arg3, arg4, arg5);
