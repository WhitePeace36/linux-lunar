From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FurryMileon <furrymileon@users.noreply.github.com>
Date: Thu, 26 Nov 2026 15:00:00 +0100
Subject: [PATCH 1/2] ntdll: Use the Syscall User Dispatch direct-upcall mode
 when available.

Every Windows-style syscall stub that falls through to the real syscall
instruction is currently delivered as SIGSYS.  Some games (THE FINALS) do
this 100-200k times per second on their main thread, and each trap pays
for a full signal round trip (signal frame with an XSAVE of the extended
state, sigsys_handler, rt_sigreturn).

Kernels with the SUD direct-upcall extension (linux-lunar patch 0014,
CachyOS/linux#15) can instead resume the thread at a registered handler.
Probe once at startup, fastest mode first:

- PR_SYS_DISPATCH_HANDLER_PUSH_RET (linux-lunar): the handler is entered
  like a CALL, the return address pushed below the red zone, so the kernel
  returns with SYSRET.  __wine_syscall_dispatcher_upcall_push pops it
  straight into the syscall frame, the same way __wine_syscall_dispatcher
  starts, and writes nothing to the stack.
- plain mode (CachyOS/linux#15): %rcx = return address, IRET exit,
  handled by __wine_syscall_dispatcher_upcall.
- otherwise the existing SIGSYS path.

Both entries fill the syscall frame the way sigsys_handler() does
(including the instrumentation callback flag) and continue in the
dispatcher prolog.  If syscall dispatch was disabled because a Unix .so
builtin was loaded, they mirror sigsys_handler() instead: dispatch is
switched off for the thread and the syscall re-executed natively, without
touching the SysV red zone.  The kernel keeps using SIGSYS for ia32
syscalls and when TF is set.  The native syscall hack keeps SIGSYS too.

Based on CachyOS/wine-cachyos#37 by FurryMileon; the PUSH_RET entry, the
probe order were added for linux-lunar.  Applies to
wine-cachyos without #37.

Assisted-by: Claude:claude-opus-5-5
---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -175,6 +175,22 @@
 #define PR_SYS_DISPATCH_ON           1
 #endif
 
+/* Syscall User Dispatch direct-upcall extension (CachyOS/linux#15, lunar).  The
+ * option number is a magic value and the mode carries bit 31, so kernels
+ * without the extension return EINVAL and we stay on the SIGSYS path. */
+#ifndef PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON
+#define PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON (0x80000000U | 3)
+#endif
+#ifndef PR_SET_SYSCALL_USER_DISPATCH_HANDLER
+#define PR_SET_SYSCALL_USER_DISPATCH_HANDLER 0x53554448  /* "SUDH" */
+#endif
+/* Enter the handler like a CALL (return address pushed below the red zone),
+ * so the kernel can return with SYSRET (linux-lunar).  Kernels without it
+ * reject the flag with EINVAL. */
+#ifndef PR_SYS_DISPATCH_HANDLER_PUSH_RET
+#define PR_SYS_DISPATCH_HANDLER_PUSH_RET (1UL << 0)
+#endif
+
 #ifndef FP_XSTATE_MAGIC1
 #define FP_XSTATE_MAGIC1 0x46505853
 #endif
@@ -538,7 +554,23 @@
 static unsigned int frame_size;
 static unsigned int xstate_size = sizeof(XSAVE_AREA_HEADER);
 static UINT64 xstate_extended_features;
-static LONG syscall_dispatch_enabled = TRUE;
+LONG syscall_dispatch_enabled = TRUE;  /* not static: read by __wine_syscall_dispatcher_upcall */
+/* how the kernel enters the SUD handler, see signal_init_process() */
+enum { SUD_UPCALL_NONE, SUD_UPCALL_RCX, SUD_UPCALL_PUSH_RET };
+static LONG syscall_dispatch_upcall = SUD_UPCALL_NONE;
+
+extern void __wine_syscall_dispatcher_upcall(void);
+extern void __wine_syscall_dispatcher_upcall_push(void);
+
+static int register_sud_handler(void)
+{
+    if (syscall_dispatch_upcall == SUD_UPCALL_PUSH_RET)
+        return prctl( PR_SET_SYSCALL_USER_DISPATCH_HANDLER,
+                      (unsigned long)__wine_syscall_dispatcher_upcall_push,
+                      PR_SYS_DISPATCH_HANDLER_PUSH_RET, 0UL, 0UL );
+    return prctl( PR_SET_SYSCALL_USER_DISPATCH_HANDLER,
+                  (unsigned long)__wine_syscall_dispatcher_upcall, 0UL, 0UL, 0UL );
+}
 
 #if defined(__linux__) || defined(__APPLE__)
 static inline TEB *get_current_teb(void)
@@ -3095,6 +3127,28 @@
             syscall_dispatch_enabled = FALSE;
         }
     }
+
+    /*
+     * Kernels with the SUD direct-upcall extension can resume a blocked
+     * syscall at a user handler instead of delivering SIGSYS
+     * (PR_SET_SYSCALL_USER_DISPATCH_HANDLER registers the handler, mode
+     * PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON arms it; both per thread, see
+     * init_syscall_frame).  Probe once here, fastest mode first: entering
+     * the handler like a CALL lets the kernel return with SYSRET, the
+     * plain mode (return address in %rcx) needs IRET.  Other kernels
+     * return EINVAL and we stay on the SIGSYS path.
+     */
+    if (syscall_dispatch_enabled)
+    {
+        syscall_dispatch_upcall = SUD_UPCALL_PUSH_RET;
+        if (register_sud_handler())
+        {
+            syscall_dispatch_upcall = SUD_UPCALL_RCX;
+            if (register_sud_handler()) syscall_dispatch_upcall = SUD_UPCALL_NONE;
+        }
+        if (syscall_dispatch_upcall)
+            TRACE_(seh)( "SUD direct-upcall mode %d available\n", (int)syscall_dispatch_upcall );
+    }
 #endif
 
     emulate_cpuid();
@@ -3131,9 +3185,20 @@
         arch_prctl( ARCH_GET_FS, &thread_data->pthread_teb );
         alloc_fs_sel( fs32_sel >> 3, get_wow_teb( teb ));
     }
-    if (syscall_dispatch_enabled && prctl( PR_SET_SYSCALL_USER_DISPATCH, PR_SYS_DISPATCH_ON,
-                                           libc_addr, libc_size, &thread_data->syscall_dispatch ) < 0)
-        WARN_(seh)( "could not enable syscall user dispatch\n" );
+    if (syscall_dispatch_enabled)
+    {
+        int err = -1;
+        /* the upcall handler is per-thread kernel state: register it for
+         * every thread before arming; not compatible with the native
+         * syscall hack, which relies on sigsys_handler() */
+        if (syscall_dispatch_upcall && !hack_native_syscalls && !register_sud_handler())
+            err = prctl( PR_SET_SYSCALL_USER_DISPATCH, (unsigned long)PR_SYS_DISPATCH_UPCALL_EXCLUSIVE_ON,
+                         libc_addr, libc_size, &thread_data->syscall_dispatch );
+        if (err < 0)
+            err = prctl( PR_SET_SYSCALL_USER_DISPATCH, PR_SYS_DISPATCH_ON,
+                         libc_addr, libc_size, &thread_data->syscall_dispatch );
+        if (err < 0) WARN_(seh)( "could not enable syscall user dispatch\n" );
+    }
 #elif defined (__FreeBSD__) || defined (__FreeBSD_kernel__)
     amd64_set_gsbase( teb );
 #elif defined(__NetBSD__)
@@ -3582,6 +3647,147 @@
                    "movl $0x10000,0xb4(%rcx)\n\t"    /* frame->restore_flags <- RESTORE_FLAGS_INSTRUMENTATION */
                    "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_prolog_end") )
 
+/***********************************************************************
+ *           __wine_syscall_dispatcher_upcall
+ *
+ * Entry point registered via PR_SET_SYSCALL_USER_DISPATCH_HANDLER.
+ * Kernel contract on entry (same as the SYSCALL instruction):
+ *   %rcx = address of the instruction after `syscall`
+ *   %r11 = RFLAGS at the syscall
+ *   %rax = syscall number
+ *   all other registers = user state at the syscall site
+ *   no signal frame, no FPU save, signal mask unchanged.
+ * The kernel keeps delivering SIGSYS for ia32 syscalls and when TF is
+ * set, so sigsys_handler() still covers those cases.
+ *
+ * %rax holds the syscall id that prolog_end stores, so %rcx/%r11 are
+ * shuffled through a 16-byte stack scratch.  Only PE code traps while
+ * dispatch is enabled, and the Win64 ABI has no red zone.
+ *
+ * Once signal_disable_syscall_dispatch() has run (a Unix .so builtin was
+ * loaded), traps may come from native code: do what sigsys_handler()
+ * does, i.e. turn dispatch off for this thread and re-execute the
+ * syscall natively.  That path skips the SysV red zone, opens the
+ * selector so its own prctl() is not dispatched, and preserves every
+ * register the retried syscall can observe.
+ */
+__ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_upcall,
+                   "cmpl $0," __ASM_NAME("syscall_dispatch_enabled") "(%rip)\n\t"
+                   "je 2f\n\t"
+                   "subq $16,%rsp\n\t"
+                   "movq %rcx,0(%rsp)\n\t"             /* address after the syscall */
+                   "movq %r11,8(%rsp)\n\t"             /* rflags */
+                   "movq %gs:0x378,%rcx\n\t"           /* thread_data->syscall_frame */
+                   "movq 0(%rsp),%r11\n\t"
+                   "movq %r11,0x10(%rcx)\n\t"          /* frame->rcx */
+                   "addq $0xb,%r11\n\t"
+                   "movq %r11,0x70(%rcx)\n\t"          /* frame->rip, prolog_end subtracts 0xb */
+                   "movq 8(%rsp),%r11\n\t"
+                   "movq %r11,0x80(%rcx)\n\t"          /* frame->eflags */
+                   "movl $0,0xb4(%rcx)\n\t"            /* frame->restore_flags */
+                   "movq %gs:0x330,%r11\n\t"           /* thread_data->instrumentation_callback */
+                   "cmpq $0,(%r11)\n\t"
+                   "je 1f\n\t"
+                   "movl $0x10000,0xb4(%rcx)\n"        /* RESTORE_FLAGS_INSTRUMENTATION */
+                   "1:\tmovq 8(%rsp),%r11\n\t"
+                   "addq $16,%rsp\n\t"
+                   "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_prolog_end") "\n"
+                   /* dispatch was disabled: prctl(OFF) for this thread and retry natively */
+                   "2:\tleaq -128(%rsp),%rsp\n\t"      /* skip the SysV red zone */
+                   "pushq %r11\n\t"
+                   "pushq %rcx\n\t"
+                   "pushq %rax\n\t"
+                   "pushq %rdi\n\t"
+                   "pushq %rsi\n\t"
+                   "pushq %rdx\n\t"
+                   "pushq %r10\n\t"
+                   "pushq %r8\n\t"
+                   "movb $0,%gs:0x340\n\t"             /* thread_data->syscall_dispatch = ALLOW */
+                   "movl $157,%eax\n\t"                /* __NR_prctl */
+                   "movl $59,%edi\n\t"                 /* PR_SET_SYSCALL_USER_DISPATCH */
+                   "xorl %esi,%esi\n\t"                /* PR_SYS_DISPATCH_OFF */
+                   "xorl %edx,%edx\n\t"
+                   "xorl %r10d,%r10d\n\t"
+                   "xorl %r8d,%r8d\n\t"
+                   "syscall\n\t"
+                   "movb $1,%gs:0x340\n\t"             /* thread_data->syscall_dispatch = BLOCK */
+                   "popq %r8\n\t"
+                   "popq %r10\n\t"
+                   "popq %rdx\n\t"
+                   "popq %rsi\n\t"
+                   "popq %rdi\n\t"
+                   "popq %rax\n\t"
+                   "popq %rcx\n\t"
+                   "subq $2,%rcx\n\t"                  /* back to the syscall instruction */
+                   "popfq\n\t"
+                   "leaq 128(%rsp),%rsp\n\t"
+                   "jmp *%rcx" )
+
+/***********************************************************************
+ *           __wine_syscall_dispatcher_upcall_push
+ *
+ * Entry point registered with PR_SYS_DISPATCH_HANDLER_PUSH_RET.  The kernel
+ * enters it like a CALL, which lets it return with SYSRET instead of IRET:
+ *   (%rsp) = address of the instruction after `syscall`
+ *   %rsp + 8 + 128 = %rsp at the syscall (the 128-byte red zone is skipped)
+ *   %rcx = this function, %r11 = RFLAGS at the syscall, %rax = syscall number
+ *   all other registers = user state at the syscall site.
+ * The return address is popped straight into the syscall frame, so unlike
+ * __wine_syscall_dispatcher_upcall nothing is written to the stack, and
+ * this matches the prolog of __wine_syscall_dispatcher itself.
+ *
+ * Once signal_disable_syscall_dispatch() has run, traps may come from
+ * native code: as in sigsys_handler(), turn dispatch off for this thread
+ * and re-execute the syscall natively.  The kernel already left the
+ * interrupted code's red zone alone, the scratch registers go below the
+ * return address.
+ */
+__ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_upcall_push,
+                   "cmpl $0," __ASM_NAME("syscall_dispatch_enabled") "(%rip)\n\t"
+                   "je 2f\n\t"
+                   "movq %gs:0x378,%rcx\n\t"           /* thread_data->syscall_frame */
+                   "popq 0x70(%rcx)\n\t"               /* frame->rip <- address after the syscall */
+                   "leaq 128(%rsp),%rsp\n\t"           /* back to %rsp at the syscall */
+                   "movq %r11,0x80(%rcx)\n\t"          /* frame->eflags */
+                   "movq 0x70(%rcx),%r11\n\t"
+                   "movq %r11,0x10(%rcx)\n\t"          /* frame->rcx */
+                   "addq $0xb,0x70(%rcx)\n\t"          /* frame->rip, prolog_end subtracts 0xb */
+                   "movl $0,0xb4(%rcx)\n\t"            /* frame->restore_flags */
+                   "movq %gs:0x330,%r11\n\t"           /* thread_data->instrumentation_callback */
+                   "cmpq $0,(%r11)\n\t"
+                   "je 1f\n\t"
+                   "movl $0x10000,0xb4(%rcx)\n"         /* RESTORE_FLAGS_INSTRUMENTATION */
+                   "1:\tmovq 0x80(%rcx),%r11\n\t"     /* %r11 = rflags, as after sigsys_handler() */
+                   "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_prolog_end") "\n"
+                   /* dispatch was disabled: prctl(OFF) for this thread and retry natively */
+                   "2:\tpushq %r11\n\t"
+                   "pushq %rax\n\t"
+                   "pushq %rdi\n\t"
+                   "pushq %rsi\n\t"
+                   "pushq %rdx\n\t"
+                   "pushq %r10\n\t"
+                   "pushq %r8\n\t"
+                   "movb $0,%gs:0x340\n\t"             /* thread_data->syscall_dispatch = ALLOW */
+                   "movl $157,%eax\n\t"                /* __NR_prctl */
+                   "movl $59,%edi\n\t"                 /* PR_SET_SYSCALL_USER_DISPATCH */
+                   "xorl %esi,%esi\n\t"                /* PR_SYS_DISPATCH_OFF */
+                   "xorl %edx,%edx\n\t"
+                   "xorl %r10d,%r10d\n\t"
+                   "xorl %r8d,%r8d\n\t"
+                   "syscall\n\t"
+                   "movb $1,%gs:0x340\n\t"             /* thread_data->syscall_dispatch = BLOCK */
+                   "popq %r8\n\t"
+                   "popq %r10\n\t"
+                   "popq %rdx\n\t"
+                   "popq %rsi\n\t"
+                   "popq %rdi\n\t"
+                   "popq %rax\n\t"
+                   "popfq\n\t"
+                   "popq %rcx\n\t"                     /* address after the syscall */
+                   "leaq -2(%rcx),%rcx\n\t"            /* back to the syscall (lea keeps the flags) */
+                   "leaq 128(%rsp),%rsp\n\t"           /* %rsp at the syscall */
+                   "jmp *%rcx" )
+
 
 /***********************************************************************
  *           __wine_unix_call_dispatcher
